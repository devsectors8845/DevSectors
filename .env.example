# Optional: send contact submissions by email through the Resend HTTP API.
# Configure all three values together; partial email configuration fails closed.
RESEND_API_KEY=
CONTACT_TO_EMAIL=devsectors@gmail.com
CONTACT_FROM_EMAIL=DevSectors Website <website@your-verified-domain.com>

# Used only when none of the email values above are configured. Relative paths
# must remain inside the app root. Use this only on a single persistent Node host.
CONTACT_STORAGE_PATH=.data/inquiries.ndjson
